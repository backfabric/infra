# OpenBao on the host (ADR 0009), with the deviations of ADR 0019: the
# upstream NixOS service `services.openbao`, configured as code.
#
#   - integrated storage (raft) in /var/lib/openbao, one node per server;
#   - static seal: OpenBao unseals itself at start with `openbao-seal-key`,
#     32 random bytes (hex) in the cluster-wide sops file
#     (`backfabric.secrets.commonFile`), generated by `backfabric keygen`.
#     Every server of a future raft cluster shares it. `secrets/common.yaml`
#     is readable by every host: before the first agent joins, the seal key
#     and the TLS material move to a file only the servers can read (as the
#     k3s token, ADR 0017);
#   - TLS only, with a certificate for the fixed name `openbao.openbao.svc`
#     (plus `.cluster.local`) and 127.0.0.1, signed by a CA of its own; both
#     from the cluster-wide sops file, generated by `backfabric keygen`. The
#     listeners are on 127.0.0.1 and the node address, port 8200; the
#     firewall opens 8200 only on `cni0`, for pods, which reach OpenBao by
#     that name through a Service without selector whose EndpointSlice
#     points at the node address;
#   - `openbao-init` initialises it once, `bao operator init`, and keeps the
#     root token and the recovery key in /var/lib/openbao-init (root only);
#   - `openbao-config` applies the options below on every change: the KV v2
#     mount `secret/`, the Kubernetes auth method `kubernetes/` against the
#     local k3s API, the policies, the Kubernetes auth roles, and the
#     permanent secrets from sops;
#   - every request is audited by the file audit device in
#     /var/log/openbao/audit.log (values HMACed), rotated daily by logrotate;
#   - a raft snapshot daily in /var/lib/openbao-snapshots, the last 14 kept.
#
# On the host, `bao` talks to the local listener (BAO_ADDR, BAO_CACERT are
# set); as root, `export BAO_TOKEN=$(cat /var/lib/openbao-init/root-token)`.
# See docs/openbao.md.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.backfabric.openbao;
  bao = config.services.openbao.package;

  port = 8200;
  # The name pods use: Service `openbao` in namespace `openbao`. The server
  # certificate is issued for it by `backfabric keygen`, so changing it
  # means issuing a new certificate.
  namespace = "openbao";
  serviceName = "openbao";
  dnsName = "${serviceName}.${namespace}.svc";
  nodeAddress = config.backfabric.network.ipv4.address;

  # The files systemd copies from /run/secrets for the service (LoadCredential),
  # so that the decrypted secrets stay root-only although OpenBao runs as a
  # dynamic user. The directory is fixed by systemd: /run/credentials/<unit>.
  credentials = "/run/credentials/openbao.service";

  initDir = "/var/lib/openbao-init";
  rootTokenFile = "${initDir}/root-token";
  snapshotDir = "/var/lib/openbao-snapshots";
  snapshotsKept = 14;
  auditLog = "/var/log/openbao/audit.log";
  k3sServerCa = "/var/lib/rancher/k3s/server/tls/server-ca.crt";

  kvMount = "secret";

  # For the bao CLI: the oneshots and the root shell on the host.
  baoEnv = {
    BAO_ADDR = "https://127.0.0.1:${toString port}";
    BAO_CACERT = config.sops.secrets.openbao-ca-cert.path;
  };

  # Reads the root token into the environment, not into an argument.
  loginRoot = ''
    BAO_TOKEN=$(<${rootTokenFile})
    export BAO_TOKEN
  '';

  init = pkgs.writeShellApplication {
    name = "openbao-init";
    runtimeInputs = [
      bao
      pkgs.jq
    ];
    text = ''
      # 0: initialised, 2: not initialised, 1: error (not reachable yet;
      # systemd starts the unit again).
      status=0
      bao operator init -status >/dev/null || status=$?
      case $status in
      0)
        [[ -s ${rootTokenFile} ]] ||
          { echo "OpenBao is initialised, but ${rootTokenFile} is missing (docs/openbao.md)." >&2; exit 1; }
        echo "OpenBao is initialised."
        exit 0
        ;;
      2) ;;
      *) exit 1 ;;
      esac

      # Never overwrite the token and recovery key of an earlier
      # initialisation: OpenBao's storage was deleted, which is not done by
      # this unit; move the files away by hand (docs/openbao.md).
      for file in ${initDir}/init.json ${rootTokenFile}; do
        [[ ! -e $file ]] || { echo "OpenBao is not initialised, but $file exists (docs/openbao.md)." >&2; exit 1; }
      done

      umask 077
      # With the static seal, init returns recovery keys instead of unseal
      # keys; one share, since they are kept in one place anyway.
      bao operator init -format=json -recovery-shares=1 -recovery-threshold=1 >${initDir}/init.json.new
      mv ${initDir}/init.json.new ${initDir}/init.json
      jq -j .root_token ${initDir}/init.json >${rootTokenFile}.new
      mv ${rootTokenFile}.new ${rootTokenFile}
      chmod 0400 ${initDir}/init.json ${rootTokenFile}
      echo "Initialised OpenBao; the root token and the recovery key are in ${initDir}."
    '';
  };

  policyFiles = lib.mapAttrs (
    name: text: pkgs.writeText "openbao-policy-${name}.hcl" text
  ) cfg.policies;

  roleFiles = lib.mapAttrs (
    name: role:
    pkgs.writeText "openbao-role-${name}.json" (
      builtins.toJSON {
        bound_service_account_names = role.serviceAccounts;
        bound_service_account_namespaces = role.namespaces;
        token_policies = role.policies;
      }
    )
  ) cfg.kubernetesRoles;

  configure = pkgs.writeShellApplication {
    name = "openbao-config";
    runtimeInputs = [
      bao
      pkgs.jq
    ];
    text = ''
      ${loginRoot}

      # Fails while OpenBao is still unsealing; systemd starts the unit again.
      bao status >/dev/null

      if ! bao secrets list -format=json | jq -e 'has("${kvMount}/")' >/dev/null; then
        bao secrets enable -path=${kvMount} -version=2 kv
      fi

      if ! bao auth list -format=json | jq -e 'has("kubernetes/")' >/dev/null; then
        bao auth enable kubernetes
      fi
      # OpenBao is not in the cluster: without token_reviewer_jwt it reviews a
      # client's token with that token itself, so each client's service
      # account needs the ClusterRole system:auth-delegator (ADR 0019).
      bao write auth/kubernetes/config \
        kubernetes_host=https://127.0.0.1:6443 \
        kubernetes_ca_cert=@${k3sServerCa} \
        disable_local_ca_jwt=true

      # Policies and roles are exactly the declared ones.
      declare -A policies=(${
        lib.concatStrings (
          lib.mapAttrsToList (name: file: "[${lib.escapeShellArg name}]=${file} ") policyFiles
        )
      })
      for name in "''${!policies[@]}"; do
        bao policy write "$name" "''${policies[$name]}" >/dev/null
      done
      bao policy list -format=json | jq -r '.[]' | while read -r name; do
        if [[ $name != default && $name != root && ! -v policies[$name] ]]; then
          bao policy delete "$name" >/dev/null
          echo "Deleted policy $name."
        fi
      done

      declare -A roles=(${
        lib.concatStrings (
          lib.mapAttrsToList (name: file: "[${lib.escapeShellArg name}]=${file} ") roleFiles
        )
      })
      for name in "''${!roles[@]}"; do
        bao write "auth/kubernetes/role/$name" - <"''${roles[$name]}" >/dev/null
      done
      # Lists nothing (exit code 2) without roles.
      { bao list -format=json auth/kubernetes/role || echo '[]'; } | jq -r '.[]' | while read -r name; do
        if [[ ! -v roles[$name] ]]; then
          bao delete "auth/kubernetes/role/$name" >/dev/null
          echo "Deleted Kubernetes auth role $name."
        fi
      done

      # The permanent secrets: written only when they differ, so that an
      # unchanged secret gets no new version. The values only pass through
      # pipes, never through arguments or files.
      ${lib.concatStrings (
        lib.mapAttrsToList (
          path: fields:
          let
            args = lib.concatStrings (
              lib.mapAttrsToList (
                field: secret: "--rawfile ${lib.escapeShellArg field} ${config.sops.secrets.${secret}.path} "
              ) fields
            );
          in
          ''
            desired=$(jq -cn ${args}'$ARGS.named')
            # Empty if the path does not exist yet (exit code 2).
            current=$(bao kv get -mount=${kvMount} -format=json ${lib.escapeShellArg path} | jq -c '.data.data' || true)
            if [[ $(printf '%s\n%s\n' "$desired" "$current" | jq -s '.[0] == .[1]') != true ]]; then
              printf '%s' "$desired" | bao kv put -mount=${kvMount} ${lib.escapeShellArg path} - >/dev/null
              echo "Wrote ${kvMount}/${path}."
            fi
          ''
        ) cfg.kv.secrets
      )}
      echo "Applied the OpenBao configuration."
    '';
  };

  snapshot = pkgs.writeShellApplication {
    name = "openbao-snapshot";
    runtimeInputs = [
      bao
      pkgs.coreutils
    ];
    text = ''
      ${loginRoot}
      umask 077
      file=${snapshotDir}/openbao-$(date -u +%Y%m%dT%H%M%SZ).snap
      bao operator raft snapshot save "$file.new"
      mv "$file.new" "$file"
      echo "Saved $file."

      # Names sort by time; keep the newest ${toString snapshotsKept}.
      shopt -s nullglob
      snapshots=(${snapshotDir}/openbao-*.snap)
      count=''${#snapshots[@]}
      for ((i = 0; i < count - ${toString snapshotsKept}; i++)); do
        rm -- "''${snapshots[i]}"
        echo "Deleted ''${snapshots[i]}."
      done
    '';
  };

  # The sops secrets of `backfabric.openbao.kv.secrets`.
  kvSecretNames = lib.unique (lib.concatMap lib.attrValues (lib.attrValues cfg.kv.secrets));
in
{
  options.backfabric.openbao = {
    policies = lib.mkOption {
      type = lib.types.attrsOf lib.types.lines;
      default = { };
      example = lib.literalExpression ''
        {
          external-secrets = '''
            path "secret/data/*" {
              capabilities = ["read"]
            }
          ''';
        }
      '';
      description = ''
        OpenBao policies (HCL) by name. Exactly these exist besides `default`
        and `root`: a policy that is removed here is deleted from OpenBao.
      '';
    };

    kubernetesRoles = lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.submodule {
          options = {
            serviceAccounts = lib.mkOption {
              type = lib.types.nonEmptyListOf lib.types.str;
              description = "Names of the service accounts that may log in with the role.";
            };
            namespaces = lib.mkOption {
              type = lib.types.nonEmptyListOf lib.types.str;
              description = "Namespaces of those service accounts.";
            };
            policies = lib.mkOption {
              type = lib.types.listOf lib.types.str;
              description = "Policies of the tokens issued for the role.";
            };
          };
        }
      );
      default = { };
      example = {
        external-secrets = {
          serviceAccounts = [ "external-secrets" ];
          namespaces = [ "external-secrets" ];
          policies = [ "external-secrets" ];
        };
      };
      description = ''
        Roles of the Kubernetes auth method (`auth/kubernetes/role/<name>`)
        by name. Exactly these exist: a role that is removed here is deleted
        from OpenBao. Each service account also needs the ClusterRole
        `system:auth-delegator`: OpenBao reviews the account's token with that
        token.
      '';
    };

    kv.secrets = lib.mkOption {
      type = lib.types.attrsOf (lib.types.attrsOf lib.types.str);
      default = { };
      example = {
        "example/app" = {
          password = "example-app-password";
        };
      };
      description = ''
        Permanent secrets, loaded from sops into the KV v2 mount `secret/` on
        every deployment: a path under the mount, mapped to its fields, each
        the name of a sops secret (`sops.secrets.<name>`; from
        `sops.defaultSopsFile` unless its `sopsFile` says otherwise). A
        path's value is replaced by exactly these fields when it differs;
        paths not listed here are left alone (secrets written at runtime).
      '';
    };
  };

  config = {
    sops.secrets = {
      openbao-seal-key = {
        sopsFile = config.backfabric.secrets.commonFile;
      };
      openbao-tls-key = {
        sopsFile = config.backfabric.secrets.commonFile;
        restartUnits = [ "openbao.service" ];
      };
      openbao-tls-cert = {
        sopsFile = config.backfabric.secrets.commonFile;
        restartUnits = [ "openbao.service" ];
      };
      # Not secret: readable by everyone, for clients on the host.
      openbao-ca-cert = {
        sopsFile = config.backfabric.secrets.commonFile;
        mode = "0444";
      };
    }
    // lib.genAttrs kvSecretNames (_: {
      restartUnits = [ "openbao-config.service" ];
    });

    services.openbao = {
      enable = true;
      settings = {
        listener = lib.genAttrs [ "loopback" "node" ] (name: {
          type = "tcp";
          address = "${if name == "loopback" then "127.0.0.1" else nodeAddress}:${toString port}";
          tls_cert_file = "${credentials}/tls-cert";
          tls_key_file = "${credentials}/tls-key";
          tls_min_version = "tls13";
        });
        api_addr = "https://${dnsName}:${toString port}";
        cluster_addr = "https://${nodeAddress}:${toString (port + 1)}";
        storage.raft = {
          path = "/var/lib/openbao";
          node_id = config.networking.hostName;
        };
        seal.static = {
          # The key's permanent identifier: a new key gets a new name.
          current_key_id = "openbao-seal-key";
          current_key = "file://${credentials}/seal-key";
        };
        # Declarative audit device: enabled at every start and SIGHUP.
        audit = [
          {
            file.file = {
              description = "Every request and response, values HMACed.";
              options = {
                file_path = auditLog;
                mode = "0600";
              };
            };
          }
        ];
      };
    };

    systemd.services.openbao = {
      # The node address must be configured before OpenBao listens on it.
      wants = [ "network-online.target" ];
      after = [ "network-online.target" ];
      serviceConfig = {
        LoadCredential = [
          "seal-key:${config.sops.secrets.openbao-seal-key.path}"
          "tls-cert:${config.sops.secrets.openbao-tls-cert.path}"
          "tls-key:${config.sops.secrets.openbao-tls-key.path}"
        ];
        # /var/log/openbao (with the dynamic user: /var/log/private/openbao,
        # which only root can enter).
        LogsDirectory = "openbao";
        LogsDirectoryMode = "0700";
      };
    };

    systemd.services.openbao-init = {
      description = "Initialise OpenBao";
      wantedBy = [ "multi-user.target" ];
      requires = [ "openbao.service" ];
      after = [ "openbao.service" ];
      environment = baoEnv;
      # systemd starts it again until OpenBao answers.
      startLimitIntervalSec = 0;
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = lib.getExe init;
        Restart = "on-failure";
        RestartSec = 5;
        StateDirectory = "openbao-init";
        StateDirectoryMode = "0700";
      };
    };

    systemd.services.openbao-config = {
      description = "Apply the OpenBao configuration";
      wantedBy = [ "multi-user.target" ];
      requires = [ "openbao-init.service" ];
      # k3s writes its server CA, which the Kubernetes auth method trusts.
      after = [
        "openbao-init.service"
        "k3s.service"
      ];
      environment = baoEnv;
      startLimitIntervalSec = 0;
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = lib.getExe configure;
        Restart = "on-failure";
        RestartSec = 10;
      };
    };

    systemd.services.openbao-snapshot = {
      description = "Save a raft snapshot of OpenBao";
      requires = [ "openbao-init.service" ];
      after = [ "openbao-init.service" ];
      environment = baoEnv;
      startAt = "daily";
      serviceConfig = {
        Type = "oneshot";
        ExecStart = lib.getExe snapshot;
        StateDirectory = "openbao-snapshots";
        StateDirectoryMode = "0700";
      };
    };
    # A snapshot missed while the host was off is taken at the next boot.
    systemd.timers.openbao-snapshot.timerConfig.Persistent = true;

    # OpenBao reopens the audit log on SIGHUP (ExecReload). nocreate: OpenBao
    # creates the new file itself, owned by its user; delaycompress: it may
    # still write to the old one until it has handled the signal.
    services.logrotate.settings.openbao = {
      files = auditLog;
      frequency = "daily";
      rotate = 30;
      compress = true;
      delaycompress = true;
      nocreate = true;
      postrotate = "systemctl try-reload-or-restart openbao.service";
    };

    environment.variables = baoEnv;

    # Pods reach OpenBao as https://openbao.openbao.svc:8200: a Service
    # without selector, whose EndpointSlice points at the node address
    # (kube-proxy translates the Service address to it; the packets arrive
    # from cni0, as for the API server).
    services.k3s.manifests.openbao.content = [
      {
        apiVersion = "v1";
        kind = "Namespace";
        metadata.name = namespace;
      }
      {
        apiVersion = "v1";
        kind = "Service";
        metadata = {
          name = serviceName;
          inherit namespace;
        };
        spec.ports = [
          {
            name = "https";
            protocol = "TCP";
            inherit port;
            targetPort = port;
          }
        ];
      }
      {
        apiVersion = "discovery.k8s.io/v1";
        kind = "EndpointSlice";
        metadata = {
          name = "${serviceName}-host";
          inherit namespace;
          labels = {
            "kubernetes.io/service-name" = serviceName;
            # Not the EndpointSlice controller's: it leaves the slice alone.
            "endpointslice.kubernetes.io/managed-by" = "backfabric";
          };
        };
        addressType = "IPv4";
        ports = [
          {
            name = "https";
            protocol = "TCP";
            inherit port;
          }
        ];
        endpoints = [ { addresses = [ nodeAddress ]; } ];
      }
    ];

    networking.firewall.interfaces.cni0.allowedTCPPorts = [ port ];
  };
}
