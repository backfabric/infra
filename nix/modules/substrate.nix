# Agent Substrate on the cluster (ADR 0023): Substrate v1.0.0 installed by
# its own installer, `ate-setup deploy ate-system`, from the release's
# prebuilt images, with its dependencies in the cluster on this node. See
# docs/substrate.md.
#
#   - the Kubernetes features Substrate's pod certificates need, which are
#     beta and off by default in 1.35 and 1.36: the feature gates ClusterTrustBundle,
#     ClusterTrustBundleProjection and PodCertificateRequest on the API
#     server, the controller manager and the kubelet, and the two v1beta1
#     resources of certificates.k8s.io in the API server's runtime-config;
#   - `substrate-install` runs `ate-setup` with the SubstrateInstall
#     document below at every deployment that changes it or the package,
#     after k3s. It waits for what it needs for a bounded time and then
#     fails, without restarting, as the OpenBao oneshots do;
#   - snapshots go to RustFS, an S3 server in ate-system (as in upstream's
#     kind install), with credentials from the cluster-wide sops file
#     (`rustfs-access-key`, `rustfs-secret-key`, generated by `backfabric
#     keygen`); a Job creates the bucket;
#   - Substrate's bundled PostgreSQL (mutual TLS with pod certificates) and
#     RustFS keep their data on static `local` PersistentVolumes in
#     /var/lib/substrate, bound to their claims by name. No StorageClass
#     object exists and no provisioner serves the class name: nothing else
#     can get a volume;
#   - ate-system, where atelet runs as root with host paths, and the
#     namespaces of WorkerPools (`workerPoolNamespaces`, and the smoke
#     test's), whose worker pods run as root with added capabilities, are
#     exempt from Pod Security Admission; in exchange their pods may only
#     run the images listed below, all pinned by digest (k3s's admission
#     policy, `backfabric.k3s.denyUnlistedImages`);
#   - sandbox class gVisor only, ingress to actors only for `kubectl ate
#     proxy` (the atenet-client service account), telemetry export off;
#   - egress credential injection (ADR 0030) only while `credentials`
#     declares one: then ate-setup deploys Substrate's Kubernetes Secrets
#     credential provider (its cluster-wide Secret read removed by the
#     package), and `substrate-credentials` writes each credential from its
#     sops secret into a Secret in `agent-credentials` (a namespace that
#     runs no pods and admits no traffic, whose declared Secrets only the
#     provider's service account may get), and the provider's
#     atespace→namespace policy, so that only the listed atespaces may use
#     each one. Without credentials injection is off.
#
# The manifests ate-setup applies are patched in nix/packages/substrate.nix.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.backfabric.substrate;
  package = pkgs.callPackage ../packages/substrate.nix { };
  inherit (package) manifests;
  k3s = lib.getExe' config.backfabric.k3s.package "k3s";
  shell = import ../lib/shell.nix;
  yaml = pkgs.formats.yaml { };

  # Fixed by the release: `deploy ate-system` refuses any other namespace
  # (RequireCanonicalNamespace), and the bundled PostgreSQL's claim is
  # `data-postgres-0` of the StatefulSet `postgres`.
  inherit (package) namespace;
  # The node the static volumes live on: k3s names the node after the host.
  nodeName = config.networking.hostName;
  # A class name only these volumes and their claims use.
  storageClass = "backfabric-local";
  dataDir = "/var/lib/substrate";
  bucket = "ate-snapshots";
  installDir = "/var/lib/substrate-install";
  kubeconfig = "/etc/rancher/k3s/k3s.yaml";

  smokeNamespace = "substrate-smoke";

  # Egress credential injection (ADR 0030): on only while credentials are
  # declared.
  inherit (package) credentialProvider;
  injection = cfg.credentials != { };
  credentialsNamespace = "agent-credentials";
  # The Secret's label the provider's policy selects each credential by, and
  # the Secret's one key.
  credentialLabel = "backfabric.dev/credential";
  credentialKey = "value";
  dnsLabel = "[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?";

  # The namespace of the credentials: no pods (quota 0), no traffic in or
  # out, and `get` on exactly the declared Secrets for the provider's
  # service account, in place of upstream's cluster-wide ClusterRole.
  credentialsNamespaceManifest = yaml.generate "agent-credentials-namespace.yaml" {
    apiVersion = "v1";
    kind = "List";
    items = [
      {
        apiVersion = "v1";
        kind = "Namespace";
        metadata.name = credentialsNamespace;
      }
      {
        apiVersion = "v1";
        kind = "ResourceQuota";
        metadata = {
          name = "no-pods";
          namespace = credentialsNamespace;
        };
        spec.hard.pods = "0";
      }
      {
        apiVersion = "networking.k8s.io/v1";
        kind = "NetworkPolicy";
        metadata = {
          name = "default-deny";
          namespace = credentialsNamespace;
        };
        spec = {
          podSelector = { };
          policyTypes = [
            "Ingress"
            "Egress"
          ];
        };
      }
      {
        apiVersion = "rbac.authorization.k8s.io/v1";
        kind = "Role";
        metadata = {
          name = credentialProvider.serviceAccount;
          namespace = credentialsNamespace;
        };
        rules = [
          {
            apiGroups = [ "" ];
            resources = [ "secrets" ];
            resourceNames = lib.attrNames cfg.credentials;
            verbs = [ "get" ];
          }
        ];
      }
      {
        apiVersion = "rbac.authorization.k8s.io/v1";
        kind = "RoleBinding";
        metadata = {
          name = credentialProvider.serviceAccount;
          namespace = credentialsNamespace;
        };
        roleRef = {
          apiGroup = "rbac.authorization.k8s.io";
          kind = "Role";
          name = credentialProvider.serviceAccount;
        };
        subjects = [
          {
            kind = "ServiceAccount";
            name = credentialProvider.serviceAccount;
            inherit namespace;
          }
        ];
      }
    ];
  };

  # The provider's atespace→namespace policy (cmd/credential-provider/
  # kubernetes-secrets/nsauthz.go): one grant per credential and atespace,
  # narrowed to that credential's Secret by its label. Default deny: an
  # atespace not listed resolves nothing.
  namespacePolicy.policies = lib.concatLists (
    lib.mapAttrsToList (
      name: c:
      map (atespace: {
        inherit atespace;
        allowedNamespaces = [ credentialsNamespace ];
        secretSelector.matchLabels.${credentialLabel} = name;
      }) c.atespaces
    ) cfg.credentials
  );
  namespacePolicyManifest = yaml.generate "credential-provider-namespace-policy.yaml" {
    apiVersion = "v1";
    kind = "ConfigMap";
    metadata = {
      name = credentialProvider.policyConfigMap;
      inherit namespace;
    };
    data.${credentialProvider.policyKey} = builtins.toJSON namespacePolicy;
  };

  credentials = pkgs.writeShellApplication {
    name = "substrate-credentials";
    runtimeInputs = [
      pkgs.jq
      pkgs.coreutils
    ];
    text = ''
      export KUBECONFIG=${kubeconfig}
      kubectl() { ${k3s} kubectl "$@"; }
      apply() { kubectl apply --server-side --force-conflicts --field-manager=substrate-credentials "$@"; }

      ${shell.waitUntil}
      ${shell.apiReady k3s}
      exists() { kubectl get "$@" >/dev/null 2>&1; }

      wait_until 300 "the k3s API with $KUBECONFIG; is k3s running? systemctl status k3s" api_ready
      apply -f ${credentialsNamespaceManifest}

      # Each credential from its sops secret, read by jq from the file: the
      # value is never in an argument (process listings), a file of its own
      # or the output. A trailing newline is not part of it.
      write_credential() {
        jq -n --arg name "$1" --rawfile value "$2" '{
          apiVersion: "v1", kind: "Secret", type: "Opaque",
          metadata: {name: $name, namespace: "${credentialsNamespace}", labels: {"${credentialLabel}": $name}},
          stringData: {"${credentialKey}": ($value | rtrimstr("\n"))}
        }' | apply -f -
      }
      ${lib.concatStrings (
        lib.mapAttrsToList (name: c: ''
          write_credential ${
            lib.escapeShellArgs [
              name
              config.sops.secrets.${c.sopsSecret}.path
            ]
          }
        '') cfg.credentials
      )}
      # Credentials no longer declared.
      kubectl -n ${credentialsNamespace} delete secret \
        -l ${lib.escapeShellArg "${credentialLabel},${credentialLabel} notin (${lib.concatStringsSep "," (lib.attrNames cfg.credentials)})"}

      # The policy, which ate-setup creates empty and never overwrites. The
      # provider loads it only at startup: its pods are replaced when the
      # policy's hash in their template changes, and only then.
      apply -f ${namespacePolicyManifest}
      wait_until 300 "the Deployment ${namespace}/${credentialProvider.deployment}; journalctl -u substrate-install" \
        exists -n ${namespace} deployment ${credentialProvider.deployment}
      kubectl -n ${namespace} patch deployment ${credentialProvider.deployment} --type=merge \
        -p '{"spec": {"template": {"metadata": {"annotations": {"backfabric.dev/namespace-policy": "${builtins.hashString "sha256" (builtins.toJSON namespacePolicy)}"}}}}}'
      kubectl -n ${namespace} rollout status deployment ${credentialProvider.deployment} --timeout=5m
    '';
  };

  features = [
    "ClusterTrustBundle"
    "ClusterTrustBundleProjection"
    "PodCertificateRequest"
  ];
  featureGates = lib.concatMapStringsSep "," (f: "${f}=true") features;
  # Only the two resources, not all of certificates.k8s.io/v1beta1 (which
  # upstream's kind cluster enables).
  runtimeConfig = lib.concatMapStringsSep "," (r: "certificates.k8s.io/v1beta1/${r}=true") [
    "clustertrustbundles"
    "podcertificaterequests"
  ];

  # Images pinned by digest (the multi-platform index): upstream's RustFS
  # and aws-cli, the release's gVisor worker, and the smoke test's.
  images = {
    rustfs = "docker.io/rustfs/rustfs:1.0.3@sha256:9ca9559533b537d10482fe923288b676ad08f92a7069d9a17327fbae3cab688b";
    awsCli = "docker.io/amazon/aws-cli:2.38.5@sha256:c8156a0e74e13929a42d7e60f0d4e14e7d28d980cd21822505d4bff80e5460c1";
    worker = package.workerImage;
    python = "docker.io/library/python:3.14-alpine@sha256:5862d971d1f0ae26b258cefa4e893556b1d3aba81bd2ff30888704ad378bab67";
  };

  # https://github.com/agent-substrate/substrate/blob/v1.0.0/docs/guides/operator-install.md
  # Only what differs from the defaults, or what must not follow a default
  # that a later release may change.
  installConfig = {
    apiVersion = "install.ate.dev/v1alpha1";
    kind = "SubstrateInstall";
    inherit kubeconfig namespace;
    # k3s's context. Also keeps ate-setup from running `gcloud container
    # clusters get-credentials`, which it does when gcp.projectID is set and
    # no context is.
    context = "default";
    images = {
      repo = "ghcr.io/agent-substrate/substrate";
      tag = "v${package.version}";
    };
    sandboxClasses = "gvisor";
    # Only `kubectl ate proxy actor`'s identity may reach actors through
    # atenet-router.
    ingressAllowedSPIFFEIDs = "spiffe://cluster.local/ns/${namespace}/sa/atenet-client";
    ateapi = {
      # The default, pinned: the service account `kubectl ate` uses.
      authz.bootstrapOwners = "system:serviceaccount:${namespace}:ate-client";
      postgres.storageClass = storageClass;
    };
    atenet = {
      dataplane = "envoy";
      # The bundled Kubernetes Secrets provider, only with credentials.
      egress.credentialProvider = builtins.toJSON (
        if injection then { name = "k8s.io"; } else { enabled = false; }
      );
    };
    storage = {
      snapshotLocation = "s3://${bucket}/";
      # Required by ate-setup on every install that is not kind
      # (Config.RequireTransferServiceAccount), and only used by the GCS
      # backend: ate-api-server's objectstore-plugin ignores it on S3
      # (cmd/objectstore-plugin/exchange.go).
      transferGSAName = "unused-with-s3";
    };
    gcp.projectID = "unused-with-s3";
    record.dir = installDir;
    # Instead of 1m: the first install pulls every image.
    rolloutTimeout = "5m";
  };
  installConfigFile = yaml.generate "substrate-install.yaml" installConfig;

  install = pkgs.writeShellApplication {
    name = "substrate-install";
    runtimeInputs = [
      package
      pkgs.jq
      pkgs.coreutils
    ];
    text = ''
      export KUBECONFIG=${kubeconfig}

      ${shell.waitUntil}
      ${shell.apiReady k3s}

      # The resources the feature gates and runtime-config above serve.
      certificates_ready() {
        ${k3s} kubectl get --raw /apis/certificates.k8s.io/v1beta1 2>/dev/null |
          jq -e '[.resources[].name] | index("clustertrustbundles") and index("podcertificaterequests")' >/dev/null
      }

      wait_until 300 "the k3s API with $KUBECONFIG; is k3s running? systemctl status k3s" api_ready
      wait_until 60 "certificates.k8s.io/v1beta1 clustertrustbundles and podcertificaterequests; check k3s's feature gates and runtime-config" certificates_ready

      # ate-setup reads its manifests relative to the first go.mod above
      # the working directory.
      cd ${manifests}
      exec ate-setup deploy ate-system --config ${installConfigFile}
    '';
  };

  # A static local volume for one claim, on this node.
  localVolume =
    {
      name,
      claim,
      size,
    }:
    {
      apiVersion = "v1";
      kind = "PersistentVolume";
      metadata.name = name;
      spec = {
        capacity.storage = size;
        accessModes = [ "ReadWriteOnce" ];
        volumeMode = "Filesystem";
        storageClassName = storageClass;
        # The data stays when the claim goes.
        persistentVolumeReclaimPolicy = "Retain";
        # Reserved for this claim: no other claim of the class binds it.
        claimRef = {
          inherit namespace;
          name = claim;
        };
        local.path = "${dataDir}/${name}";
        nodeAffinity.required.nodeSelectorTerms = [
          {
            matchExpressions = [
              {
                key = "kubernetes.io/hostname";
                operator = "In";
                values = [ nodeName ];
              }
            ];
          }
        ];
      };
    };

  # The volume directories, owned by the user each image runs as:
  # postgres:18-alpine's postgres (70; the entrypoint starts as root and
  # changes to it), rustfs's rustfs (10001).
  volumes = {
    postgres = {
      claim = "data-postgres-0";
      # The claim's size after nix/packages/substrate.nix.
      size = "10Gi";
      uid = 70;
    };
    rustfs = {
      claim = "rustfs-data";
      # Nominal: a local volume is not limited to its capacity; the
      # snapshots share the host's file system.
      size = "100Gi";
      uid = 10001;
    };
  };

  # The Service, Secret and keys the patched Substrate manifests use
  # (nix/packages/substrate.nix).
  inherit (package) rustfs;
  rustfsLabels.app = rustfs.service;
  secretEnv = name: key: {
    inherit name;
    valueFrom.secretKeyRef = {
      name = rustfs.secret;
      inherit key;
    };
  };

  # Pod Security `restricted`, also where the namespace does not enforce it.
  restrictedPod = uid: {
    runAsNonRoot = true;
    runAsUser = uid;
    runAsGroup = uid;
    seccompProfile.type = "RuntimeDefault";
  };
  restrictedContainer = {
    allowPrivilegeEscalation = false;
    readOnlyRootFilesystem = true;
    capabilities.drop = [ "ALL" ];
  };

  # Derived from upstream's manifests/ate-install/kind/rustfs.yaml.
  rustfsManifest = [
    # Also created by ate-setup; here so that RustFS does not wait for it.
    {
      apiVersion = "v1";
      kind = "Namespace";
      metadata.name = namespace;
    }
    {
      apiVersion = "v1";
      kind = "PersistentVolumeClaim";
      metadata = {
        name = volumes.rustfs.claim;
        inherit namespace;
      };
      spec = {
        accessModes = [ "ReadWriteOnce" ];
        storageClassName = storageClass;
        volumeName = "rustfs";
        resources.requests.storage = volumes.rustfs.size;
      };
    }
    {
      apiVersion = "v1";
      kind = "Service";
      metadata = {
        name = rustfs.service;
        inherit namespace;
      };
      spec = {
        selector = rustfsLabels;
        ports = [
          {
            name = "api";
            inherit (rustfs) port;
            targetPort = "api";
          }
        ];
      };
    }
    {
      apiVersion = "apps/v1";
      kind = "Deployment";
      metadata = {
        name = "rustfs";
        inherit namespace;
      };
      spec = {
        replicas = 1;
        # One server on the volume at a time.
        strategy.type = "Recreate";
        selector.matchLabels = rustfsLabels;
        template = {
          metadata.labels = rustfsLabels;
          spec = {
            securityContext = restrictedPod volumes.rustfs.uid;
            automountServiceAccountToken = false;
            enableServiceLinks = false;
            containers = [
              {
                name = "rustfs";
                image = images.rustfs;
                ports = [
                  {
                    name = "api";
                    containerPort = rustfs.port;
                  }
                ];
                env = [
                  {
                    name = "RUSTFS_ADDRESS";
                    value = ":${toString rustfs.port}";
                  }
                  # Upstream's kind install serves the web console on 9001;
                  # nothing here uses it.
                  {
                    name = "RUSTFS_CONSOLE_ENABLE";
                    value = "false";
                  }
                  {
                    name = "RUSTFS_VOLUMES";
                    value = "/data";
                  }
                  (secretEnv "RUSTFS_ACCESS_KEY" rustfs.accessKeyKey)
                  (secretEnv "RUSTFS_SECRET_KEY" rustfs.secretKeyKey)
                ];
                securityContext = restrictedContainer;
                readinessProbe.tcpSocket.port = "api";
                resources.requests = {
                  cpu = "50m";
                  memory = "128Mi";
                };
                volumeMounts = [
                  {
                    name = "data";
                    mountPath = "/data";
                  }
                  # The image's log directory (RUSTFS_OBS_LOG_DIRECTORY),
                  # with the root file system read-only.
                  {
                    name = "logs";
                    mountPath = "/logs";
                  }
                  {
                    name = "tmp";
                    mountPath = "/tmp";
                  }
                ];
              }
            ];
            volumes = [
              {
                name = "data";
                persistentVolumeClaim.claimName = volumes.rustfs.claim;
              }
              {
                name = "logs";
                emptyDir = { };
              }
              {
                name = "tmp";
                emptyDir = { };
              }
            ];
          };
        };
      };
    }
    # Upstream's bucket Job: creates the bucket once RustFS answers, and
    # succeeds if it exists.
    {
      apiVersion = "batch/v1";
      kind = "Job";
      metadata = {
        name = "rustfs-bucket-init";
        inherit namespace;
      };
      spec = {
        backoffLimit = 10;
        template.spec = {
          restartPolicy = "OnFailure";
          securityContext = restrictedPod 65534;
          automountServiceAccountToken = false;
          enableServiceLinks = false;
          containers = [
            {
              name = "create-bucket";
              image = images.awsCli;
              env = [
                (secretEnv "AWS_ACCESS_KEY_ID" rustfs.accessKeyKey)
                (secretEnv "AWS_SECRET_ACCESS_KEY" rustfs.secretKeyKey)
                {
                  name = "AWS_REGION";
                  value = rustfs.region;
                }
                {
                  name = "AWS_ENDPOINT_URL";
                  value = rustfs.endpoint;
                }
                # The CLI's cache and history, with the root file system
                # read-only.
                {
                  name = "HOME";
                  value = "/tmp";
                }
              ];
              command = [
                "/bin/sh"
                "-c"
                ''
                  set -e
                  for i in $(seq 1 60); do
                    if aws s3api head-bucket --bucket ${bucket} 2>/dev/null; then
                      echo "bucket ${bucket} already exists"
                      exit 0
                    fi
                    if aws s3api create-bucket --bucket ${bucket} 2>/dev/null; then
                      echo "bucket ${bucket} created"
                      exit 0
                    fi
                    echo "waiting for rustfs to become available... ($i/60)"
                    sleep 2
                  done
                  echo "timed out waiting for rustfs"
                  exit 1
                ''
              ];
              securityContext = restrictedContainer;
              volumeMounts = [
                {
                  name = "tmp";
                  mountPath = "/tmp";
                }
              ];
            }
          ];
          volumes = [
            {
              name = "tmp";
              emptyDir = { };
            }
          ];
        };
      };
    }
    # ate-system denies all ingress by default (upstream's
    # ate-system-networkpolicies.yaml); RustFS's API only from the pods
    # whose objectstore-plugin sidecar uses it, and from the bucket Job.
    {
      apiVersion = "networking.k8s.io/v1";
      kind = "NetworkPolicy";
      metadata = {
        name = "rustfs";
        inherit namespace;
      };
      spec = {
        podSelector.matchLabels = rustfsLabels;
        policyTypes = [ "Ingress" ];
        ingress = [
          {
            from = [
              {
                podSelector.matchExpressions = [
                  {
                    key = "app";
                    operator = "In";
                    values = [
                      "ate-api-server"
                      "atelet"
                    ];
                  }
                ];
              }
              { podSelector.matchLabels."batch.kubernetes.io/job-name" = "rustfs-bucket-init"; }
            ];
            ports = [
              {
                protocol = "TCP";
                port = "api";
              }
            ];
          }
        ];
      };
    }
  ];

  # The smoke test (docs/substrate.md), applied by hand: a gVisor
  # WorkerPool with one worker, and an actor template whose container
  # counts POST requests in memory and in a file on its durable volume.
  smokeWorkerPool = {
    apiVersion = "v1";
    kind = "List";
    items = [
      {
        apiVersion = "v1";
        kind = "Namespace";
        metadata.name = smokeNamespace;
      }
      {
        apiVersion = "ate.dev/v1";
        kind = "WorkerPool";
        metadata = {
          name = "smoke";
          namespace = smokeNamespace;
          labels.workload = "substrate-smoke";
        };
        spec = {
          replicas = 1;
          workerImage = images.worker;
          sandboxClasses = [ { name = "gvisor"; } ];
          # As upstream's counter demo: the limits are the worker's capacity
          # for actors, the requests what the scheduler reserves.
          template.resources = {
            limits = {
              cpu = "1";
              memory = "1Gi";
            };
            requests = {
              cpu = "250m";
              memory = "1Gi";
            };
          };
        };
      }
    ];
  };

  counter = ''
    import http.server, os

    PATH = "/data/counter"
    memory = 0

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            self.reply(b"ok\n" if self.path == "/readyz" else b"POST / to count\n")

        def do_POST(self):
            global memory
            memory += 1
            try:
                with open(PATH) as f:
                    stored = int(f.read())
            except FileNotFoundError:
                stored = 0
            stored += 1
            with open(PATH + ".new", "w") as f:
                f.write(str(stored))
                f.flush()
                os.fsync(f.fileno())
            os.replace(PATH + ".new", PATH)
            self.reply(f"memory={memory} file={stored}\n".encode())

        def reply(self, body):
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    http.server.ThreadingHTTPServer(("", 80), Handler).serve_forever()
  '';

  # ateapi.ActorTemplate in its protojson form (`kubectl ate create
  # actor-template -f`), shaped as upstream's
  # demos/counter/counter-template.yaml.tmpl.
  smokeActorTemplate = {
    metadata = {
      atespace = smokeNamespace;
      name = "counter";
    };
    workerSelector.matchLabels.workload = "substrate-smoke";
    containers = [
      {
        name = "counter";
        image = images.python;
        command = [
          "python3"
          "-u"
          "-c"
          counter
        ];
        wakeupProbe.httpGet = {
          path = "/readyz";
          port = 80;
        };
        volumeMounts = [
          {
            name = "data";
            mountPath = "/data";
          }
        ];
      }
    ];
    resources.limits = {
      cpuMillicores = 500;
      memoryBytes = 268435456;
    };
    # Memory, root file system and durable volumes: both counters continue
    # after a suspend.
    snapshotConfig.preferredFidelity = "SNAPSHOT_FIDELITY_MEMORY";
    volumes = [
      {
        name = "data";
        durableDir = { };
      }
    ];
  };

  # The k3s manifests this module deploys, by name: deployed while it is
  # enabled, and removed (backfabric.k3s.removedManifests) while it is not.
  k3sManifests = {
    substrate-volumes.content = lib.mapAttrsToList (
      name: v:
      localVolume {
        inherit name;
        inherit (v) claim size;
      }
    ) volumes;
    substrate-rustfs.content = rustfsManifest;
    substrate-rustfs-credentials.source =
      config.sops.templates."substrate-rustfs-credentials.yaml".path;
  };
in
{
  options.backfabric.substrate = {
    enable = lib.mkEnableOption "Agent Substrate on the cluster (docs/substrate.md)";

    workerPoolNamespaces = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = [ "agents" ];
      description = ''
        Namespaces that hold WorkerPools. Each is exempt from Pod Security
        Admission (worker pods run as root with added capabilities, seccomp
        and AppArmor Unconfined), and its pods may only run the release's
        gVisor worker image, pinned by digest. The namespaces, WorkerPools
        and actors themselves are the consumer's (docs/substrate.md).
      '';
    };

    smokeTest.enable = lib.mkEnableOption ''
      the smoke test: the namespace `${smokeNamespace}` exempt as a
      WorkerPool namespace, and its manifests in /etc/substrate/smoke
      (docs/substrate.md)
    '';

    credentials = lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.submodule (
          { name, ... }:
          {
            options = {
              sopsSecret = lib.mkOption {
                type = lib.types.str;
                default = name;
                description = ''
                  The sops secret with the value (`sops.secrets.<name>`; from
                  `sops.defaultSopsFile` unless its `sopsFile` says
                  otherwise).
                '';
              };
              atespaces = lib.mkOption {
                type = lib.types.nonEmptyListOf (lib.types.strMatching dnsLabel);
                description = "The atespaces whose actors' egress policies may inject it.";
              };
            };
          }
        )
      );
      default = { };
      example = {
        openai-api-key.atespaces = [ "agents" ];
      };
      description = ''
        Credentials Agent Substrate's egress gateway injects into actors'
        requests (ADR 0030), by name. Each becomes the Secret
        `${credentialsNamespace}/<name>` with the key `${credentialKey}`, at
        every deployment and whenever its sops secret changes, and an egress
        policy names it as
        `ate-secret://k8s.io/default/${credentialsNamespace}/<name>/${credentialKey}`.
        Only actors of the listed atespaces may use it. Declaring any turns
        egress credential injection on (`k8s.io` provider); none keeps it
        off. See docs/substrate.md.
      '';
    };
  };

  # Disabled: k3s removes what the manifests applied (docs/substrate.md,
  # "Disable", lists what stays).
  config = lib.mkMerge [
    { backfabric.k3s.removedManifests = lib.mkIf (!cfg.enable) (lib.attrNames k3sManifests); }
    (lib.mkIf cfg.enable {
      assertions = [
        {
          assertion =
            lib.intersectLists cfg.workerPoolNamespaces [
              "kube-system"
              namespace
            ] == [ ];
          message = "backfabric.substrate.workerPoolNamespaces must not contain kube-system or ${namespace}";
        }
        {
          assertion = lib.all (n: builtins.match dnsLabel n != null) (lib.attrNames cfg.credentials);
          message = "backfabric.substrate.credentials: names must be DNS labels (lowercase letters, digits, `-`)";
        }
      ];

      sops.secrets = lib.mkMerge [
        (lib.genAttrs [ "rustfs-access-key" "rustfs-secret-key" ] (_: {
          sopsFile = config.backfabric.secrets.commonFile;
        }))
        # A changed value is written again.
        (lib.genAttrs (lib.unique (lib.mapAttrsToList (_: c: c.sopsSecret) cfg.credentials)) (_: {
          restartUnits = [ "substrate-credentials.service" ];
        }))
      ];

      # The Secret RustFS, its bucket Job and Substrate's objectstore-plugin
      # sidecars read, rendered by sops-nix into /run/secrets/rendered (a
      # tmpfs, root only) and deployed by k3s from there; it is encrypted at
      # rest in etcd.
      sops.templates."substrate-rustfs-credentials.yaml" = {
        content = builtins.toJSON {
          apiVersion = "v1";
          kind = "Secret";
          metadata = {
            name = rustfs.secret;
            inherit namespace;
          };
          stringData = {
            ${rustfs.accessKeyKey} = config.sops.placeholder.rustfs-access-key;
            ${rustfs.secretKeyKey} = config.sops.placeholder.rustfs-secret-key;
          };
        };
      };

      services.k3s = {
        extraFlags = [
          "--kube-apiserver-arg=feature-gates=${featureGates}"
          "--kube-apiserver-arg=runtime-config=${runtimeConfig}"
          "--kube-controller-manager-arg=feature-gates=${featureGates}"
        ];
        extraKubeletConfig.featureGates = lib.genAttrs features (_: true);
        manifests = k3sManifests;
      };

      # Each exempt namespace's pods are limited to the images listed, by
      # k3s's admission policy (backfabric.k3s.podSecurityExemptions).
      backfabric.k3s.podSecurityExemptions = {
        # atelet (DaemonSet): root, the host paths /var/lib/ate,
        # /var/lib/kubelet/plugins, /var/lib/kubelet/device-plugins and /dev,
        # and CHOWN, DAC_OVERRIDE, FOWNER, FSETID (manifests/ate-install/
        # atelet.yaml); the bundled PostgreSQL's main container runs as root
        # (postgres/postgres.yaml). Neither passes `baseline`. Upstream's
        # other ate-system workloads set no seccomp profile either.
        # The images: what ate-setup deploys there (checked against the
        # patched manifests when the package is built), RustFS and its bucket
        # Job, and with credentials the credential provider.
        ${namespace}.images =
          package.systemImages
          ++ [
            images.rustfs
            images.awsCli
          ]
          ++ lib.optional injection credentialProvider.image;
      }
      # Worker pods, created by ate-controller in a WorkerPool's
      # namespace: root, the host path /var/lib/ate, SYS_ADMIN, NET_ADMIN
      # and seven more capabilities, seccomp and AppArmor Unconfined
      # (cmd/atecontroller/internal/controllers/workerpool_apply.go). The
      # worker pod runs only the WorkerPool's worker image; the actor's
      # images run inside its sandbox, not as containers of the pod.
      // lib.genAttrs (cfg.workerPoolNamespaces ++ lib.optional cfg.smokeTest.enable smokeNamespace) (_: {
        images = [ images.worker ];
      });

      systemd.tmpfiles.settings."10-backfabric-substrate" = {
        ${dataDir}.d = {
          mode = "0755";
          user = "root";
          group = "root";
        };
      }
      // lib.mapAttrs' (
        name: v:
        lib.nameValuePair "${dataDir}/${name}" {
          d = {
            mode = "0700";
            user = toString v.uid;
            group = toString v.uid;
          };
        }
      ) volumes;

      # No Restart=: waits for the API server for a bounded time (the
      # script's wait_until; TimeoutStartSec as the backstop) and then fails,
      # so that a deployment reports it. RemainAfterExit: runs again when the
      # unit changes, which it does with the package or the SubstrateInstall
      # document (both are in ExecStart), and at boot.
      systemd.services.substrate-install = {
        description = "Install Agent Substrate with ate-setup";
        wantedBy = [ "multi-user.target" ];
        # ate-setup resolves the image tags to digests at ghcr.io.
        wants = [ "network-online.target" ];
        after = [
          "network-online.target"
          "k3s.service"
        ];
        environment.HOME = installDir;
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          ExecStart = lib.getExe install;
          TimeoutStartSec = "30min";
          StateDirectory = "substrate-install";
          StateDirectoryMode = "0700";
          PrivateTmp = true;
        };
      };

      # Runs at every deployment (as postgres-credentials), at boot, when a
      # credential's sops secret changes (restartUnits), and again after
      # each run of substrate-install (Requires), which may have redeployed
      # the provider. No Restart=: waits for what it needs for a bounded
      # time and then fails, so that a deployment reports it.
      systemd.services.substrate-credentials = lib.mkIf injection {
        description = "Write Agent Substrate's egress credentials and the provider's policy";
        wantedBy = [ "multi-user.target" ];
        requires = [ "substrate-install.service" ];
        after = [
          "k3s.service"
          "substrate-install.service"
        ];
        serviceConfig = {
          Type = "oneshot";
          ExecStart = lib.getExe credentials;
          TimeoutStartSec = "15min";
        };
      };

      environment.systemPackages = [
        (pkgs.runCommand "kubectl-ate-${package.version}" { } ''
          mkdir -p $out/bin
          ln -s ${package}/bin/kubectl-ate $out/bin/kubectl-ate
        '')
      ];

      environment.etc = lib.mkIf cfg.smokeTest.enable {
        "substrate/smoke/workerpool.yaml".source = yaml.generate "workerpool.yaml" smokeWorkerPool;
        "substrate/smoke/actor-template.yaml".source =
          yaml.generate "actor-template.yaml" smokeActorTemplate;
      };
    })
  ];
}
