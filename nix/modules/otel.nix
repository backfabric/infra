# OpenTelemetry Collector on the host for audit telemetry (ADR 0021): the
# upstream NixOS service `services.opentelemetry-collector` with the
# `otelcol-k8s` distribution, configured as code.
#
#   - OTLP over gRPC (4317) and HTTP (4318), TLS only, with a certificate
#     for the fixed name `otel-collector.otel.svc` (plus `.cluster.local`)
#     and 127.0.0.1, signed by the CA of OpenBao's certificate (ADR 0019);
#     key and certificate from the cluster-wide sops file, generated by
#     `backfabric keygen`. The listeners are on 127.0.0.1 and the node
#     address; the firewall opens both ports only on `cni0`, for pods, which
#     reach the Collector by that name through a Service without selector
#     whose EndpointSlice points at the node address;
#   - every sender authenticates with a Kubernetes service account token
#     whose audience is `otel-collector` (a projected token), verified by the
#     OIDC authenticator against k3s's service account issuer. The
#     Collector cannot use OIDC discovery (the issuer's name does not
#     resolve on the host, and the API server rejects anonymous requests),
#     so `otel-jwks` copies the issuer's public keys (JWKS) from the API
#     server into /var/lib/otel-jwks at every deployment and daily; the
#     Collector reloads the file when it changes, and keeps working with the
#     last copy when the cluster is down;
#   - the source identity is stamped from the verified token: the resource
#     attributes `backfabric.source.*`, `k8s.namespace.name`,
#     `service.namespace` and `service.name` always come from the token and
#     the connection, never from the sender; every other `k8s.*` resource
#     attribute the sender set is dropped, and so is `backfabric.*` anywhere
#     in the data;
#   - credentials are masked: attributes whose key looks like a credential
#     (authorization, cookie, API key, token, secret, password, ...), and
#     values that look like one (bearer and basic credentials, JWTs, private
#     keys, common API key formats, passwords in URLs);
#   - everything that passes is written, unsampled and unbatched, to an
#     append-only archive of OTLP JSON lines, one file per signal, in
#     /var/log/otel-collector (with the dynamic user:
#     /var/log/private/otel-collector, which only root can enter), rotated at
#     100 MB and kept for 365 days.
#
# The archive is the audit of record for trusted sources (services outside
# the agents' reach) and what the agents claim for everything else; see
# docs/otel.md.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  # The name pods use: Service `otel-collector` in namespace `otel`. The
  # server certificate is issued for it by `backfabric keygen`, so changing
  # it means issuing a new certificate.
  namespace = "otel";
  serviceName = "otel-collector";
  nodeAddress = config.backfabric.network.ipv4.address;
  listenAddresses = {
    loopback = "127.0.0.1";
    node = nodeAddress;
  };
  ports = {
    otlp-grpc = 4317;
    otlp-http = 4318;
  };

  # The audience senders request for their projected token.
  audience = "otel-collector";
  # k3s's service account issuer (`https://kubernetes.default.svc.` and the
  # cluster domain, pkg/daemons/control/server.go); `otel-jwks` checks it
  # against the API server's discovery document.
  issuer = "https://kubernetes.default.svc.cluster.local";
  jwksDir = "/var/lib/otel-jwks";
  jwksFile = "${jwksDir}/jwks.json";

  # The files systemd copies from /run/secrets for the service
  # (LoadCredential), so that the decrypted key stays root-only although the
  # Collector runs as a dynamic user.
  credentials = "/run/credentials/opentelemetry-collector.service";

  archiveDir = "/var/log/otel-collector";
  signals = [
    "traces"
    "metrics"
    "logs"
  ];
  archiveFile = signal: "${archiveDir}/${signal}.jsonl";

  # Attribute keys whose values are credentials (case-insensitive, as a
  # whole word of the key): HTTP headers as semantic conventions record them
  # (`http.request.header.authorization`), and common names.
  credentialKeys = lib.concatStringsSep "|" [
    "authorization"
    "proxy-authorization"
    "cookie"
    "set-cookie"
    "x-api-key"
    "api[-_]?key"
    "x-auth-token"
    "access[-_]?token"
    "refresh[-_]?token"
    "id[-_]?token"
    "token"
    "secret"
    "client[-_]?secret"
    "password"
    "passwd"
    "credentials?"
    "private[-_]?key"
  ];

  # Values that are credentials wherever they appear, in any attribute or
  # log body (the match is replaced by ****).
  credentialValues = [
    # HTTP Authorization values.
    "(?i)\\b(bearer|basic)\\s+[A-Za-z0-9._~+/=-]{8,}"
    # JSON Web Tokens (service account tokens, OIDC tokens).
    "\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*"
    # PEM private keys, to the end marker or the end of the value.
    "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?(-----END [A-Z ]*PRIVATE KEY-----|$)"
    # Passwords in URLs (scheme://user:password@).
    "(?i)\\b[a-z][a-z0-9+.-]*://[^/\\s:@]+:[^/\\s@]+@"
    # key=value and key: value pairs with a credential-like key.
    "(?i)\\b(password|passwd|pwd|secret|token|api[-_]?key|access[-_]?key|client[-_]?secret)\\s*[=:]\\s*[^\\s&,;\"']{6,}"
    # Common API key and token formats: OpenAI and Anthropic (sk-...),
    # GitHub, Slack, Google, AWS access key ids, OpenBao tokens, k3s tokens.
    "\\bsk-[A-Za-z0-9_-]{20,}"
    "\\bgh[pousr]_[A-Za-z0-9]{30,}"
    "\\bgithub_pat_[A-Za-z0-9_]{22,}"
    "\\bxox[abposr]-[A-Za-z0-9-]{10,}"
    "\\bAIza[0-9A-Za-z_-]{35}"
    "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b"
    "\\b(hv[sbr]|s|b|r)\\.[A-Za-z0-9_-]{24,}"
    "\\bK10[0-9a-f]{64}::[a-z]+:[0-9a-f]+"
  ];

  # The resource attributes the Collector stamps from the authentication.
  # Applied to every resource before anything else reads it.
  identityActions = [
    # What the sender says about itself is not evidence.
    {
      pattern = "^k8s\\.";
      action = "delete";
    }
    {
      pattern = "^backfabric\\.";
      action = "delete";
    }
    {
      key = "service.name";
      action = "delete";
    }
    {
      key = "service.namespace";
      action = "delete";
    }
    # The verified token's subject,
    # `system:serviceaccount:<namespace>:<service account>`.
    {
      key = "backfabric.source.subject";
      action = "insert";
      from_context = "auth.subject";
    }
    # The connection's peer address (the pod's IP).
    {
      key = "backfabric.source.address";
      action = "insert";
      from_context = "client.address";
    }
  ];

  # OTTL: the namespace and service account from the subject, as the
  # Collector's own attributes and as the standard ones Collector-side and
  # UI tools read; and no `backfabric.*` attribute below the resource, where
  # a sender could otherwise imitate the stamp.
  subjectPattern = "^system:serviceaccount:(?P<namespace>[^:]+):(?P<serviceaccount>[^:]+)$";
  identityStatements = [
    "merge_maps(cache, ExtractPatterns(attributes[\"backfabric.source.subject\"], \"${subjectPattern}\"), \"upsert\") where attributes[\"backfabric.source.subject\"] != nil"
    "set(attributes[\"backfabric.source.namespace\"], cache[\"namespace\"]) where cache[\"namespace\"] != nil"
    "set(attributes[\"backfabric.source.service_account\"], cache[\"serviceaccount\"]) where cache[\"serviceaccount\"] != nil"
    "set(attributes[\"k8s.namespace.name\"], cache[\"namespace\"]) where cache[\"namespace\"] != nil"
    "set(attributes[\"service.namespace\"], cache[\"namespace\"]) where cache[\"namespace\"] != nil"
    "set(attributes[\"service.name\"], cache[\"serviceaccount\"]) where cache[\"serviceaccount\"] != nil"
  ];
  dropStamp = context: {
    inherit context;
    statements = [ "delete_matching_keys(attributes, \"^backfabric\\\\.\")" ];
  };
  resourceGroup = {
    context = "resource";
    statements = identityStatements;
  };

  settings = {
    extensions.oidc.providers = [
      {
        issuer_url = issuer;
        inherit audience;
        public_keys_file = jwksFile;
      }
    ];

    # One receiver per address, as OpenBao's listeners: 127.0.0.1 for
    # clients on the host, the node address for pods.
    receivers = lib.mapAttrs' (name: address: {
      name = "otlp/${name}";
      value.protocols =
        let
          server = port: {
            endpoint = "${address}:${toString port}";
            tls = {
              cert_file = "${credentials}/tls-cert";
              key_file = "${credentials}/tls-key";
              min_version = "1.3";
            };
            auth.authenticator = "oidc";
          };
        in
        {
          grpc = server ports.otlp-grpc;
          http = server ports.otlp-http;
        };
    }) listenAddresses;

    processors = {
      # Refuses data (a retryable error for the sender) before the
      # Collector runs out of memory; MemoryMax below is the backstop.
      memory_limiter = {
        check_interval = "1s";
        limit_mib = 400;
        spike_limit_mib = 100;
      };
      # Reads the authentication from the request's context: it must run
      # before anything that batches requests.
      "resource/identity".attributes = identityActions;
      "transform/identity" = {
        error_mode = "propagate";
        trace_statements = [
          resourceGroup
          (dropStamp "span")
          (dropStamp "spanevent")
        ];
        metric_statements = [
          resourceGroup
          (dropStamp "datapoint")
        ];
        log_statements = [
          resourceGroup
          (dropStamp "log")
        ];
      };
      redaction = {
        allow_all_keys = true;
        blocked_key_patterns = [ "(?i)(^|[._-])(${credentialKeys})($|[._-])" ];
        blocked_values = credentialValues;
        # Also lists, maps and numbers, as their string form.
        redact_all_types = true;
        # Counts of masked attributes on each record, not their keys.
        summary = "info";
      };
    };

    exporters = lib.listToAttrs (
      map (signal: {
        name = "file/${signal}";
        value = {
          path = archiveFile signal;
          format = "json";
          # Rotation reopens the file in append mode (`append` is for
          # exporters without rotation). Size rather than time: the volume
          # of agents' telemetry is unknown; 100 MB files stay easy to read
          # with jq. 365 days of history, the backups removed only by age.
          rotation = {
            max_megabytes = 100;
            max_days = 365;
            max_backups = 0;
          };
        };
      }) signals
    );

    service = {
      extensions = [ "oidc" ];
      pipelines = lib.genAttrs signals (signal: {
        receivers = map (name: "otlp/${name}") (lib.attrNames listenAddresses);
        processors = [
          "memory_limiter"
          "resource/identity"
          "transform/identity"
          "redaction"
        ];
        exporters = [ "file/${signal}" ];
      });
    };
  };

  k3s = lib.getExe' config.backfabric.k3s.package "k3s";

  jwks = pkgs.writeShellApplication {
    name = "otel-jwks";
    runtimeInputs = [
      pkgs.jq
      pkgs.coreutils
      # cmp: the key set is replaced only when it changed.
      pkgs.diffutils
    ];
    text = ''
      export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

      # api_ready: whether the API server answers with the admin kubeconfig.
      api_ready() {
        [[ -s $KUBECONFIG ]] && ${k3s} kubectl get --raw /readyz >/dev/null 2>&1
      }

      deadline=$((SECONDS + 120))
      until api_ready; do
        if ((SECONDS >= deadline)); then
          echo "Gave up waiting for the k3s API with $KUBECONFIG; is k3s running? systemctl status k3s" >&2
          exit 1
        fi
        sleep 2
      done

      actual=$(${k3s} kubectl get --raw /.well-known/openid-configuration | jq -r .issuer)
      if [[ $actual != "${issuer}" ]]; then
        echo "The service account issuer is $actual, not ${issuer}: the Collector would reject every token." >&2
        exit 1
      fi

      umask 022
      ${k3s} kubectl get --raw /openid/v1/jwks >${jwksFile}.new
      jq -e '.keys | length > 0' ${jwksFile}.new >/dev/null || {
        echo "The API server returned no public keys; ${jwksFile}.new kept for inspection." >&2
        exit 1
      }
      # Replaced only when it differs: the Collector reloads it on every
      # change of the file.
      if cmp -s ${jwksFile}.new ${jwksFile}; then
        rm ${jwksFile}.new
        echo "${jwksFile} is current."
      else
        mv ${jwksFile}.new ${jwksFile}
        echo "Wrote ${jwksFile}."
      fi
    '';
  };
in
{
  config = {
    sops.secrets = lib.genAttrs [ "otel-tls-key" "otel-tls-cert" ] (_: {
      sopsFile = config.backfabric.secrets.commonFile;
      restartUnits = [ "opentelemetry-collector.service" ];
    });

    services.opentelemetry-collector = {
      enable = true;
      # The distribution for Kubernetes: the components above, and fewer
      # others than `opentelemetry-collector-contrib`.
      package = pkgs.opentelemetry-collector-releases.otelcol-k8s;
      inherit settings;
    };

    systemd.services.opentelemetry-collector = {
      # Starts with the last copy of the keys when `otel-jwks` fails (the
      # cluster is down); without any copy (the first start), it fails and
      # is restarted until `otel-jwks` has written one.
      wants = [
        "network-online.target"
        "otel-jwks.service"
      ];
      after = [
        "network-online.target"
        "otel-jwks.service"
      ];
      serviceConfig = {
        LoadCredential = [
          "tls-cert:${config.sops.secrets.otel-tls-cert.path}"
          "tls-key:${config.sops.secrets.otel-tls-key.path}"
        ];
        # /var/log/otel-collector (with the dynamic user:
        # /var/log/private/otel-collector, which only root can enter).
        LogsDirectory = "otel-collector";
        LogsDirectoryMode = "0700";
        UMask = "0077";
        # The exporter creates archive files with mode 0640 and gives
        # rotated files the mode of the one before: created here first,
        # with 0600. Appending nothing leaves an existing file unchanged.
        ExecStartPre = map (
          signal: "${pkgs.bash}/bin/sh -c ': >>${archiveFile signal} && chmod 0600 ${archiveFile signal}'"
        ) signals;
        # The upstream unit adds systemd-journal; the Collector reads no
        # journal.
        SupplementaryGroups = lib.mkForce [ ];
        MemoryMax = "512M";
        # Instead of the default 100 ms: a missing key file or listener
        # address is retried every 5 s and never hits the start limit.
        RestartSec = "5s";
      };
    };

    # No Restart=: waits for the API server for a bounded time and then
    # fails, so that a deployment reports it.
    systemd.services.otel-jwks = {
      description = "Copy the service account issuer's keys for the OpenTelemetry Collector";
      wantedBy = [ "multi-user.target" ];
      after = [ "k3s.service" ];
      startAt = "daily";
      serviceConfig = {
        Type = "oneshot";
        ExecStart = lib.getExe jwks;
        TimeoutStartSec = "3min";
        # Public keys: readable by the Collector's dynamic user.
        StateDirectory = "otel-jwks";
        StateDirectoryMode = "0755";
      };
    };
    systemd.timers.otel-jwks.timerConfig.Persistent = true;

    # Pods reach the Collector as otel-collector.otel.svc:4317 (gRPC) and
    # :4318 (HTTP): a Service without selector, whose EndpointSlice points
    # at the node address (kube-proxy translates the Service address to it;
    # the packets arrive from cni0, as for the API server).
    services.k3s.manifests.otel.content =
      let
        servicePorts = lib.mapAttrsToList (name: port: {
          inherit name port;
          protocol = "TCP";
        }) ports;
      in
      [
        {
          apiVersion = "v1";
          kind = "Namespace";
          metadata.name = namespace;
        }
        {
          apiVersion = "v1";
          kind = "Service";
          metadata = {
            name = serviceName;
            inherit namespace;
          };
          spec.ports = map (p: p // { targetPort = p.port; }) servicePorts;
        }
        {
          apiVersion = "discovery.k8s.io/v1";
          kind = "EndpointSlice";
          metadata = {
            name = "${serviceName}-host";
            inherit namespace;
            labels = {
              "kubernetes.io/service-name" = serviceName;
              # Not the EndpointSlice controller's: it leaves the slice alone.
              "endpointslice.kubernetes.io/managed-by" = "backfabric";
            };
          };
          addressType = "IPv4";
          ports = servicePorts;
          endpoints = [ { addresses = [ nodeAddress ]; } ];
        }
      ];

    networking.firewall.interfaces.cni0.allowedTCPPorts = lib.attrValues ports;
  };
}
