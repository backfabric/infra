# k3s server with embedded etcd: the first server of the cluster
# (ADR 0006), on an IPv4-only flannel network (ADR 0007), hardened as the
# K3s CIS hardening guide says, with the deviations of ADR 0017.
#
#   - `clusterInit`: etcd instead of SQLite, so that more servers can join
#     later without a datastore migration;
#   - the cluster token from sops (`k3s-token` in the cluster-wide sops file,
#     `backfabric.secrets.commonFile`), generated by `backfabric keygen`. It
#     is fixed from the first start: an etcd snapshot can only be restored
#     with the token of the cluster that took it. `secrets/common.yaml` is
#     readable by every host; before the first agent joins, the server token
#     moves to a file only the servers can read, and agents get their own
#     agent token (ADR 0017);
#   - packaged components that the cluster does not use are disabled
#     (traefik, servicelb, metrics-server, local-storage); CoreDNS and the
#     embedded NetworkPolicy controller (kube-router) stay; their images come
#     from the package's airgap archive, not from a registry;
#   - Secrets are encrypted at rest in etcd with the `secretbox` provider;
#   - etcd snapshots with k3s's defaults: every 12 hours, the last 5, in
#     /var/lib/rancher/k3s/server/db/snapshots;
#   - the hardening guide's flags, kernel parameters, Pod Security Admission
#     (restricted outside kube-system), and audit log; plus
#     DenyServiceExternalIPs and an admission policy that rejects NodePort
#     and LoadBalancer Services, so nothing in the cluster is reachable from
#     outside;
#   - the Kubernetes API is not reachable from outside: no port is opened on
#     the uplink. `kubectl` runs on the host as root, with the kubeconfig k3s
#     writes to /etc/rancher/k3s/k3s.yaml;
#   - manifests that modules no longer deploy are removed from the cluster
#     (`backfabric.k3s.removedManifests`, below).
#
# Removing manifests. k3s applies every file in
# /var/lib/rancher/k3s/server/manifests and ignores files that disappear:
# their objects and their Addon (kube-system) stay. nixpkgs'
# `services.k3s.manifests` never removes a symlink it created, and a
# symlink that dangles (e.g. into /run/secrets once its sops secret is gone)
# stops k3s from processing the whole directory. So a module whose
# manifests can be turned off lists their names in `removedManifests` while
# it is off, from one let-binding used for both, so the lists cannot drift:
#
#     names = [ "foo" "foo-credentials" ];
#     services.k3s.manifests = lib.mkIf cfg.enable (lib.genAttrs names ...);
#     backfabric.k3s.removedManifests = lib.mkIf (!cfg.enable) names;
#
# A host configuration sets it directly for a module it stopped importing.
# Each name becomes a k3s `--disable` entry, k3s's mechanism for removing
# manifests, and its symlink is replaced by an empty manifest, so that the
# file exists (k3s only visits existing files) and k3s can read it. k3s
# then deletes every object it applied from that file (of the kinds the
# Addon's `addon.k3s.cattle.io/gvks` annotation records, which k3s updates
# after every successful apply), the file, and the Addon. Consequences:
#   - changing the list changes k3s's flags: the deployment restarts k3s
#     (pods keep running);
#   - removing a manifest that contains a Namespace deletes everything in
#     that namespace, also objects that did not come from the manifest;
#   - a removed PersistentVolume with reclaim policy Retain leaves its data
#     on the host;
#   - names of k3s's packaged components (coredns, local-storage, ...) must
#     not be listed: k3s would uninstall them;
#   - systemd-tmpfiles links the empty manifest again (at boot); k3s deletes
#     it again, which removes nothing more.
# Objects removed from a manifest that is still deployed need none of this:
# k3s prunes them when it applies the changed file.
#
# Joining further servers or agents is not implemented yet.
#
# Guide: https://docs.k3s.io/security/hardening-guide ("v1.29 and Newer").
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.backfabric.k3s;

  # The guide's psa.yaml (PodSecurity) plus the EventRateLimit configuration
  # the guide asks for (control 1.2.9), with the example limits of the
  # Kubernetes documentation (admission-controllers#eventratelimit).
  admissionConfig = builtins.toFile "k3s-admission-config.json" (
    builtins.toJSON {
      apiVersion = "apiserver.config.k8s.io/v1";
      kind = "AdmissionConfiguration";
      plugins = [
        {
          name = "PodSecurity";
          configuration = {
            apiVersion = "pod-security.admission.config.k8s.io/v1";
            kind = "PodSecurityConfiguration";
            defaults = {
              enforce = "restricted";
              enforce-version = "latest";
              audit = "restricted";
              audit-version = "latest";
              warn = "restricted";
              warn-version = "latest";
            };
            exemptions = {
              usernames = [ ];
              runtimeClasses = [ ];
              namespaces = [ "kube-system" ];
            };
          };
        }
        {
          name = "EventRateLimit";
          configuration = {
            apiVersion = "eventratelimit.admission.k8s.io/v1alpha1";
            kind = "Configuration";
            limits = [
              {
                type = "Namespace";
                qps = 50;
                burst = 100;
                cacheSize = 2000;
              }
              {
                type = "User";
                qps = 10;
                burst = 50;
              }
            ];
          };
        }
      ];
    }
  );

  # The guide's audit.yaml: every request at level Metadata (no request or
  # response bodies, so Secret values never reach the log).
  auditPolicy = builtins.toFile "k3s-audit-policy.json" (
    builtins.toJSON {
      apiVersion = "audit.k8s.io/v1";
      kind = "Policy";
      rules = [ { level = "Metadata"; } ];
    }
  );

  auditLogDir = "/var/lib/rancher/k3s/server/logs";

  # Rejects Services that kube-proxy would expose on the node's addresses:
  # NodePort (and LoadBalancer, which allocates NodePorts) are DNATed in
  # PREROUTING to pod IPs, so that traffic is forwarded and never meets the
  # host's input firewall. k3s's own Services (the API server's
  # `kubernetes`, CoreDNS's `kube-dns`) are ClusterIP.
  externalServicesPolicy = "backfabric-deny-external-services";

  manifestDir = "/var/lib/rancher/k3s/server/manifests";

  # Linked in place of every removed manifest: k3s only visits files that
  # exist and can be read.
  removedManifest = builtins.toFile "k3s-removed-manifest.yaml" ''
    # Listed in backfabric.k3s.removedManifests: k3s deletes this file, the
    # objects it applied from the manifest of this name, and its Addon.
  '';

  # The names k3s matches `--disable` entries against: the file names
  # without their extension.
  deployedManifests = lib.mapAttrsToList (
    _: m: lib.removeSuffix ".${lib.last (lib.splitString "." m.target)}" m.target
  ) (lib.filterAttrs (_: m: m.enable) config.services.k3s.manifests);
in
{
  options.backfabric.k3s = {
    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.k3s_1_36;
      defaultText = lib.literalExpression "pkgs.k3s_1_36";
      description = ''
        The k3s package. Pinned to a minor version rather than `pkgs.k3s`, so
        that a `nix flake update` of nixpkgs never upgrades the cluster to the
        next minor version by accident; k3s minor versions must be upgraded one
        at a time. The default is the newest minor version of the NixOS stable
        release (ADR 0002).
      '';
    };

    removedManifests = lib.mkOption {
      # An Addon name: k3s names the Addon of a manifest after its file name.
      type = lib.types.listOf (lib.types.strMatching "[a-z0-9]([-a-z0-9]*[a-z0-9])?");
      default = [ ];
      example = [
        "foo"
        "foo-credentials"
      ];
      description = ''
        Names of k3s manifests (`services.k3s.manifests`) that are no longer
        deployed. Each becomes a k3s `--disable` entry, and its file in
        ${manifestDir} is replaced by an empty manifest: k3s deletes every
        object it applied from that manifest, the file, and its Addon.
        Set by modules for their manifests while they are turned off; a
        host configuration sets it for a module it no longer imports.
        Changing the list restarts k3s; removing a manifest with a
        Namespace deletes everything in that namespace. Must not contain
        deployed manifests or k3s's packaged components (coredns, ...).
      '';
    };
  };

  config = {
    assertions = [
      {
        assertion = lib.intersectLists deployedManifests cfg.removedManifests == [ ];
        message = "backfabric.k3s.removedManifests contains deployed k3s manifests: ${lib.concatStringsSep ", " (lib.intersectLists deployedManifests cfg.removedManifests)}";
      }
    ];

    sops.secrets.k3s-token = {
      sopsFile = config.backfabric.secrets.commonFile;
      # k3s runs as root and reads the file when it starts.
      owner = "root";
      mode = "0400";
    };

    # The kernel parameters the kubelet checks with protect-kernel-defaults
    # (the guide's /etc/sysctl.d/90-kubelet.conf). It also checks
    # kernel.keys.root_maxkeys and root_maxbytes, whose kernel defaults
    # already match. kernel.panic: reboot 10 s after a panic (the host then
    # waits for the LUKS passphrase).
    boot.kernel.sysctl = {
      "vm.panic_on_oom" = 0;
      "vm.overcommit_memory" = 1;
      "kernel.panic" = 10;
      "kernel.panic_on_oops" = 1;
    };

    services.k3s = {
      enable = true;
      inherit (cfg) package;
      role = "server";
      clusterInit = true;
      # A string, not a Nix path: the decrypted file in /run/secrets.
      tokenFile = config.sops.secrets.k3s-token.path;
      # The address etcd and the API server advertise, instead of k3s's
      # guess from the default route.
      nodeIP = config.backfabric.network.ipv4.address;
      # Packaged components the cluster does not use, and the manifests no
      # longer deployed: k3s deletes what it applied from both.
      disable = [
        "traefik"
        "servicelb"
        "metrics-server"
        "local-storage"
      ]
      ++ cfg.removedManifests;
      # The images of the k3s release for the host's platform (CoreDNS,
      # pause, the Helm controller's job, ...), linked into
      # /var/lib/rancher/k3s/agent/images; k3s imports them into containerd
      # when it starts and watches the directory: the system pods need no
      # registry.
      images = [ cfg.package.airgap-images ];
      # The guide's kubelet-arg values, as a kubelet configuration file
      # (k3s adds it as a drop-in after its own defaults).
      extraKubeletConfig = {
        streamingConnectionIdleTimeout = "5m";
        tlsCipherSuites = [
          "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
          "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384"
          "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
          "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
          "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305"
          "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305"
        ];
      };
      extraFlags = [
        # k3s's defaults, set explicitly: they cannot be changed without
        # rebuilding the cluster (ADR 0007).
        "--cluster-cidr=10.42.0.0/16"
        "--service-cidr=10.43.0.0/16"
        # The guide, plus the secretbox provider (ADR 0017).
        "--secrets-encryption"
        "--secrets-encryption-provider=secretbox"
        "--protect-kernel-defaults"
        # The guide's list (NodeRestriction is k3s's default), plus
        # DenyServiceExternalIPs: Kubernetes' mitigation for CVE-2020-8554.
        "--kube-apiserver-arg=enable-admission-plugins=NodeRestriction,EventRateLimit,DenyServiceExternalIPs"
        "--kube-apiserver-arg=admission-control-config-file=${admissionConfig}"
        "--kube-apiserver-arg=audit-log-path=${auditLogDir}/audit.log"
        "--kube-apiserver-arg=audit-policy-file=${auditPolicy}"
        "--kube-apiserver-arg=audit-log-maxage=30"
        "--kube-apiserver-arg=audit-log-maxbackup=10"
        "--kube-apiserver-arg=audit-log-maxsize=100"
        "--kube-apiserver-arg=service-account-extend-token-expiration=false"
        "--kube-controller-manager-arg=terminated-pod-gc-threshold=100"
      ];
      # Deployed by k3s from /var/lib/rancher/k3s/server/manifests, as the
      # guide deploys its policies.
      manifests.${externalServicesPolicy}.content = [
        {
          apiVersion = "admissionregistration.k8s.io/v1";
          kind = "ValidatingAdmissionPolicy";
          metadata.name = externalServicesPolicy;
          spec = {
            failurePolicy = "Fail";
            matchConstraints.resourceRules = [
              {
                apiGroups = [ "" ];
                apiVersions = [ "v1" ];
                operations = [
                  "CREATE"
                  "UPDATE"
                ];
                resources = [ "services" ];
              }
            ];
            validations = [
              {
                expression = "!has(object.spec.type) || !(object.spec.type in ['NodePort', 'LoadBalancer'])";
                message = "Services of type NodePort or LoadBalancer are not allowed: kube-proxy would expose them on the node's addresses, around the host firewall. Use type ClusterIP.";
                reason = "Forbidden";
              }
            ];
          };
        }
        {
          apiVersion = "admissionregistration.k8s.io/v1";
          kind = "ValidatingAdmissionPolicyBinding";
          metadata.name = externalServicesPolicy;
          spec = {
            policyName = externalServicesPolicy;
            validationActions = [
              "Deny"
              "Audit"
            ];
          };
        }
      ];
    };

    # The guide: create the log directory with mode 0700 before k3s starts.
    # The API server creates the log file with mode 0600. And the empty
    # manifest in place of every removed one (`L+` replaces the symlink
    # nixpkgs left, even a dangling one).
    systemd.tmpfiles.settings."10-backfabric-k3s" = {
      ${auditLogDir}.d = {
        mode = "0700";
        user = "root";
        group = "root";
      };
    }
    // lib.genAttrs (map (name: "${manifestDir}/${name}.yaml") cfg.removedManifests) (_: {
      "L+".argument = "${removedManifest}";
    });

    # Pods reach the API server through the `kubernetes` service, which
    # kube-proxy translates to this node's address, port 6443; the packets
    # arrive from the flannel bridge cni0 and pass the host's input chain.
    # Only this port, and only from cni0 (k3s's docs trust the whole pod and
    # service CIDRs instead, ADR 0017): the uplink stays closed.
    networking.firewall.interfaces.cni0.allowedTCPPorts = [ 6443 ];
  };
}
